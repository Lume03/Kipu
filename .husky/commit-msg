#!/usr/bin/env sh

# Source ~/.huskyrc if it exists (for GUI tools like Android Studio)
if [ -f "$HOME/.huskyrc" ]; then
  . "$HOME/.huskyrc"
fi

# Fallback: ensure fnm / nvm paths are available if not loaded yet
if ! command -v pnpm >/dev/null 2>&1; then
  if command -v fnm >/dev/null 2>&1; then
    eval "$(fnm env)"
  elif [ -d "$HOME/.local/share/fnm" ]; then
    export PATH="$HOME/.local/share/fnm:$PATH"
    eval "$(fnm env 2>/dev/null)"
  elif [ -s "$HOME/.nvm/nvm.sh" ]; then
    export NVM_DIR="$HOME/.nvm"
    . "$NVM_DIR/nvm.sh"
  fi
fi

# Strip AI co-author trailers so assistants never show up as repo contributors
grep -viE '^co-authored-by:.*(claude|anthropic|noreply@anthropic\.com)' "${1}" > "${1}.tmp" || true
mv "${1}.tmp" "${1}"

pnpm exec commitlint --edit "${1}"
